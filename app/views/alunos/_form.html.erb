<%= form_with model: aluno,
              url: aluno.new_record? ? turma_alunos_path(aluno.turma) : aluno_path(aluno),
              html: { multipart: true },
              class: "space-y-4" do |form| %>

  <!-- ERROS -->
  <% if aluno.errors.any? %>

    <div class="border border-red-200 bg-red-50
                rounded-lg px-4 py-3 text-sm text-red-700">

      <p class="font-semibold mb-1">
        Verifique os dados informados:
      </p>

      <ul class="list-disc pl-5">
        <% aluno.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>


  <!-- CARD -->
  <div class="bg-white border border-slate-200
              rounded-xl shadow-sm overflow-hidden">


    <!-- FOTO -->
    <div class="p-5 sm:p-6 border-b border-slate-100">

      <div class="flex items-center gap-4">

        <!-- PREVIEW -->
        <div class="w-16 h-16 rounded-full
                    bg-slate-100 border border-slate-200
                    overflow-hidden shrink-0
                    flex items-center justify-center">

          <% if aluno.foto.attached? %>

            <%= image_tag aluno.foto,
                id: "foto-preview",
                class: "w-full h-full object-cover" %>

          <% else %>

            <img id="foto-preview"
                 class="hidden w-full h-full object-cover"
                 alt="Foto do aluno">

            <svg id="foto-placeholder"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 class="w-7 h-7 text-slate-400">

              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 11-7.5 0
                       3.75 3.75 0 017.5 0z
                       M4.501 20.118a7.5 7.5 0
                       0114.998 0A17.933 17.933 0
                       0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />

            </svg>

          <% end %>

        </div>


        <!-- UPLOAD -->
        <div class="min-w-0">

          <p class="text-sm font-semibold text-slate-800">
            Foto do aluno
          </p>

          <p class="text-xs text-slate-500 mt-0.5 mb-2">
            JPG, PNG ou WEBP
          </p>

          <%= form.file_field :foto,
              id: "aluno_foto",
              accept: "image/jpeg,image/png,image/webp",
              class: "block text-xs text-slate-500
                      file:mr-3
                      file:border-0
                      file:rounded-md
                      file:bg-slate-100
                      file:px-3
                      file:py-1.5
                      file:text-xs
                      file:font-semibold
                      file:text-slate-700
                      hover:file:bg-slate-200
                      file:cursor-pointer" %>

        </div>

      </div>

    </div>


    <!-- CAMPOS -->
    <div class="p-5 sm:p-6 space-y-5">


      <!-- NOME -->
      <div>

        <%= form.label :nome,
            "Nome completo",
            class: "block text-sm font-medium text-slate-700 mb-1.5" %>

        <%= form.text_field :nome,
            placeholder: "Nome completo do aluno",
            class: "block w-full rounded-lg
                    border border-slate-300
                    bg-white px-3 py-2.5
                    text-sm text-slate-900
                    placeholder:text-slate-400
                    outline-none
                    focus:border-blue-500
                    focus:ring-2 focus:ring-blue-100" %>

      </div>


      <!-- TURMA + NFC -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- TURMA -->
        <div>

          <%= form.label :turma_id,
              "Turma",
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>

          <%= form.collection_select :turma_id,
              Turma.where(ativa: true).order(:nome),
              :id,
              :nome,
              {},
              class: "block w-full rounded-lg
                      border border-slate-300
                      bg-white px-3 py-2.5
                      text-sm text-slate-900
                      outline-none
                      focus:border-blue-500
                      focus:ring-2 focus:ring-blue-100" %>

        </div>


        <!-- NFC -->
        <div>

          <%= form.label :nfc_uid,
              "UID da pulseira NFC",
              class: "block text-sm font-medium text-slate-700 mb-1.5" %>

          <%= form.text_field :nfc_uid,
              placeholder: "Ex.: 04A3F29B7C",
              autocomplete: "off",
              class: "block w-full rounded-lg
                      border border-slate-300
                      bg-white px-3 py-2.5
                      text-sm font-mono uppercase
                      text-slate-900
                      placeholder:text-slate-400
                      outline-none
                      focus:border-blue-500
                      focus:ring-2 focus:ring-blue-100" %>

        </div>

      </div>


      <!-- ATIVO -->
      <div class="pt-1">

        <label class="inline-flex items-center gap-2.5 cursor-pointer">

          <%= form.check_box :ativo,
              class: "w-4 h-4 rounded
                      border-slate-300
                      text-blue-600
                      focus:ring-blue-500" %>

          <span class="text-sm font-medium text-slate-700">
            Aluno ativo
          </span>

        </label>

      </div>

    </div>


    <!-- RODAPÉ -->
    <div class="flex flex-col-reverse sm:flex-row
                sm:items-center sm:justify-end gap-2
                bg-slate-50 border-t border-slate-200
                px-5 sm:px-6 py-4">

      <%= link_to "Cancelar",
          aluno.new_record? ? turma_path(aluno.turma) : aluno_path(aluno),
          class: "inline-flex justify-center
                  px-4 py-2 rounded-lg
                  border border-slate-300
                  bg-white hover:bg-slate-100
                  text-sm font-medium text-slate-700
                  transition" %>

      <%= form.submit aluno.new_record? ? "Cadastrar aluno" : "Salvar alterações",
          class: "cursor-pointer
                  px-4 py-2 rounded-lg
                  bg-blue-600 hover:bg-blue-700
                  text-sm font-semibold text-white
                  transition" %>

    </div>

  </div>

<% end %>


<script>
  function configurarFotoAluno() {
    const input = document.getElementById("aluno_foto");

    if (!input || input.dataset.previewAtivo === "true") return;

    input.dataset.previewAtivo = "true";

    input.addEventListener("change", function() {
      const file = this.files[0];

      if (!file) return;

      const preview = document.getElementById("foto-preview");
      const placeholder = document.getElementById("foto-placeholder");

      if (!preview) return;

      preview.src = URL.createObjectURL(file);
      preview.classList.remove("hidden");

      if (placeholder) {
        placeholder.classList.add("hidden");
      }
    });
  }

  document.addEventListener("turbo:load", configurarFotoAluno);
  configurarFotoAluno();
</script>
