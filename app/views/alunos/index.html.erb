<!-- BREADCRUMB -->
<div class="text-sm text-slate-500 mb-5">
  Início <span class="mx-2">›</span>
  <span class="text-slate-800 font-medium">Alunos</span>
</div>

<!-- CABEÇALHO -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-8">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl">
      👥
    </div>

    <div>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">
        Alunos
      </h1>

      <p class="text-slate-500 mt-1">
        Gerencie os alunos e suas identificações NFC.
      </p>
    </div>
  </div>
</div>

<!-- CARDS -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-7">

  <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-blue-100 flex items-center justify-center text-2xl">
        👥
      </div>

      <div>
        <p class="text-3xl font-bold text-slate-900">
          <%= @alunos.count %>
        </p>
        <p class="text-sm text-slate-500">Total de alunos</p>
      </div>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center text-2xl">
        ✓
      </div>

      <div>
        <p class="text-3xl font-bold text-slate-900">
          <%= @alunos.count(&:ativo?) %>
        </p>
        <p class="text-sm text-slate-500">Alunos ativos</p>
      </div>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-violet-100 flex items-center justify-center text-2xl">
        )))
      </div>

      <div>
        <p class="text-3xl font-bold text-slate-900">
          <%= @alunos.count { |aluno| aluno.nfc_uid.present? } %>
        </p>
        <p class="text-sm text-slate-500">NFC vinculados</p>
      </div>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-amber-100 flex items-center justify-center text-2xl">
        ⚠
      </div>

      <div>
        <p class="text-3xl font-bold text-slate-900">
          <%= @alunos.count { |aluno| aluno.nfc_uid.blank? } %>
        </p>
        <p class="text-sm text-slate-500">Sem NFC</p>
      </div>
    </div>
  </div>

</div>

<!-- FILTROS -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 mb-6">
  <div class="flex flex-col lg:flex-row gap-4">

    <div class="flex-1">
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Buscar aluno
      </label>

      <input
        type="text"
        placeholder="Digite o nome do aluno..."
        class="w-full border border-slate-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100">
    </div>

    <div class="lg:w-72">
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Turma
      </label>

      <select class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-white">
        <option>Todas as turmas</option>

        <% Turma.order(:nome).each do |turma| %>
          <option><%= turma.nome %></option>
        <% end %>
      </select>
    </div>

    <div class="flex items-end">
      <button class="w-full lg:w-auto bg-blue-600 hover:bg-blue-700 text-white px-7 py-3 rounded-xl font-semibold transition">
        Filtrar
      </button>
    </div>

  </div>
</div>

<!-- TABELA -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

  <div class="overflow-x-auto">

    <table class="w-full">

      <thead class="bg-slate-50 border-b border-slate-200">
        <tr class="text-left text-sm text-slate-500">
          <th class="px-6 py-4">Aluno</th>
          <th class="px-6 py-4">Turma</th>
          <th class="px-6 py-4">NFC</th>
          <th class="px-6 py-4">Situação</th>
          <th class="px-6 py-4 text-right">Ações</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">

        <% @alunos.each do |aluno| %>

          <tr class="hover:bg-slate-50 transition">

            <!-- ALUNO -->
            <td class="px-6 py-4">

              <div class="flex items-center gap-4">

                <% if aluno.foto.attached? %>

                  <%= image_tag aluno.foto,
                      class: "w-11 h-11 rounded-xl object-cover" %>

                <% else %>

                  <div class="w-11 h-11 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
                    <%= aluno.nome.first.upcase %>
                  </div>

                <% end %>

                <div>
                  <p class="font-semibold text-slate-900">
                    <%= aluno.nome %>
                  </p>

                  <p class="text-xs text-slate-400">
                    Aluno
                  </p>
                </div>

              </div>

            </td>

            <!-- TURMA -->
            <td class="px-6 py-4">
              <span class="text-slate-700">
                <%= aluno.turma.nome %>
              </span>
            </td>

            <!-- NFC -->
            <td class="px-6 py-4">

              <% if aluno.nfc_uid.present? %>

                <div>
                  <span class="inline-flex items-center gap-2 text-emerald-700 font-semibold text-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    Vinculado
                  </span>

                  <p class="text-xs text-slate-400 font-mono mt-1">
                    <%= aluno.nfc_uid %>
                  </p>
                </div>

              <% else %>

                <span class="inline-flex items-center gap-2 text-amber-600 text-sm font-semibold">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  Sem pulseira
                </span>

              <% end %>

            </td>

            <!-- SITUAÇÃO -->
            <td class="px-6 py-4">

              <% if aluno.ativo? %>

                <span class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-xs font-semibold">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Ativo
                </span>

              <% else %>

                <span class="inline-flex bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-semibold">
                  Inativo
                </span>

              <% end %>

            </td>

            <!-- AÇÕES -->
            <td class="px-6 py-4 text-right">

              <%= link_to "Visualizar",
                  aluno_path(aluno),
                  class: "inline-flex px-4 py-2 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-sm transition" %>

            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

  <!-- VAZIO -->
  <% if @alunos.empty? %>

    <div class="py-16 px-5 text-center">

      <div class="w-20 h-20 mx-auto rounded-2xl bg-blue-50 flex items-center justify-center text-4xl mb-5">
        👥
      </div>

      <h3 class="text-xl font-bold text-slate-900">
        Nenhum aluno cadastrado
      </h3>

      <p class="text-slate-500 mt-2 max-w-md mx-auto">
        Para cadastrar um aluno, primeiro abra uma turma e selecione
        "Cadastrar aluno".
      </p>

      <%= link_to "Ver turmas",
          turmas_path,
          class: "inline-flex mt-6 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold" %>

    </div>

  <% end %>

</div>
