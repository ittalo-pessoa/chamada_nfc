<%= form_with model: turma, class: "space-y-6" do |form| %>

  <% if turma.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <div class="flex gap-3">
        <div class="text-red-500">⚠</div>

        <div>
          <p class="font-semibold text-red-800">
            Não foi possível salvar a turma
          </p>

          <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
            <% turma.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :nome, "Nome da turma",
        class: "block text-sm font-semibold text-slate-700 mb-2" %>

    <%= form.text_field :nome,
        placeholder: "Ex.: 3ª Série N - Informática",
        class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <div>
      <%= form.label :serie, "Série",
          class: "block text-sm font-semibold text-slate-700 mb-2" %>

      <%= form.text_field :serie,
          placeholder: "Ex.: 3ª Série",
          class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
    </div>

    <div>
      <%= form.label :curso, "Curso",
          class: "block text-sm font-semibold text-slate-700 mb-2" %>

      <%= form.text_field :curso,
          placeholder: "Ex.: Informática",
          class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
    </div>

  </div>

  <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
    <label class="flex items-center gap-3 cursor-pointer">
      <%= form.check_box :ativa,
          class: "w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>

      <div>
        <p class="font-semibold text-slate-800">Turma ativa</p>
        <p class="text-sm text-slate-500">
          Turmas inativas permanecem no histórico.
        </p>
      </div>
    </label>
  </div>

  <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-4 border-t border-slate-200">

    <%= link_to "Cancelar",
        turmas_path,
        class: "text-center px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 transition" %>

    <%= form.submit "Salvar turma",
        class: "cursor-pointer px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition" %>

  </div>

<% end %>
