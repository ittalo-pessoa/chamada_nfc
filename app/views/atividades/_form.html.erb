<%= form_with model: atividade, class: "space-y-5" do |form| %>

  <% if atividade.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <p class="text-sm font-semibold text-red-700 mb-2">
        Verifique os dados informados:
      </p>

      <ul class="text-sm text-red-600 list-disc pl-5">
        <% atividade.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 rounded-xl p-5">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <!-- NOME -->
      <div>
        <%= form.label :nome, "Nome da atividade",
            class: "block text-sm font-medium text-slate-700 mb-1" %>

        <%= form.text_field :nome,
            placeholder: "Ex.: Aula de Programação",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
                    focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none" %>
      </div>


      <!-- TIPO -->
      <div>
        <%= form.label :tipo_atividade, "Tipo",
            class: "block text-sm font-medium text-slate-700 mb-1" %>

        <%= form.select :tipo_atividade,
            Atividade::TIPOS,
            { prompt: "Selecione o tipo" },
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
                    focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none" %>
      </div>

      <!-- DATA -->
<div>
  <%= form.label :inicio, "Data",
      class: "block text-sm font-medium text-slate-700 mb-1" %>

  <%= form.date_field :inicio,
      value: atividade.inicio&.to_date || Date.current,
      class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
              focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none" %>
</div>


    <!-- TURMA -->
<div>
  <%= form.label :turma_ids, "Turma",
      class: "block text-sm font-medium text-slate-700 mb-1" %>

  <%= form.select :turma_ids,
      options_from_collection_for_select(
        @turmas,
        :id,
        :nome,
        atividade.turma_ids.first
      ),
      { prompt: "Selecione a turma" },
      class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
              focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none" %>

  <p class="text-xs text-slate-400 mt-1">
    Todos os alunos ativos desta turma participarão da atividade.
  </p>
</div>




      <!-- LOCAL -->
      <div>
        <%= form.label :local, "Local (opcional)",
            class: "block text-sm font-medium text-slate-700 mb-1" %>

        <%= form.text_field :local,
            placeholder: "Ex.: Laboratório de Informática",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
                    focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none" %>
      </div>

    </div>


    <!-- OBSERVAÇÃO -->
    <div class="mt-4">

      <%= form.label :observacao, "Observação (opcional)",
          class: "block text-sm font-medium text-slate-700 mb-1" %>

      <%= form.text_area :observacao,
          rows: 3,
          placeholder: "Informações adicionais sobre a atividade...",
          class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm
                  focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none resize-none" %>

    </div>


    <!-- BOTÕES -->
    <div class="flex justify-end gap-2 mt-5 pt-4 border-t border-slate-100">

      <%= link_to "Cancelar",
          atividades_path,
          class: "px-4 py-2 text-sm border border-slate-300
                  rounded-lg text-slate-600 hover:bg-slate-50" %>

      <%= form.submit "Salvar atividade",
          class: "cursor-pointer px-4 py-2 text-sm font-semibold
                  bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>

    </div>

  </div>

<% end %>
