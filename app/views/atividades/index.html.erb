<div class="w-full max-w-6xl mx-auto">

  <!-- CABEÇALHO -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">
        Atividades
      </h1>

      <p class="text-sm text-slate-500 mt-1">
        Acompanhe as atividades pedagógicas cadastradas.
      </p>
    </div>

    <%= link_to new_atividade_path,
    class: "inline-flex items-center gap-1.5 self-start sm:self-auto px-3 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-700 transition" do %>

  <svg xmlns="http://www.w3.org/2000/svg"
       viewBox="0 0 24 24"
       fill="none"
       stroke="currentColor"
       stroke-width="2"
       style="width: 14px; height: 14px; flex: none;">
    <path stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 5v14M5 12h14" />
  </svg>

  <span>Nova atividade</span>

<% end %>


  <!-- FILTROS -->
  <div class="bg-white border border-slate-200 rounded-xl p-4 mb-4">

    <%= form_with url: atividades_path,
                  method: :get,
                  local: true,
                  class: "flex flex-col md:flex-row gap-3" do |form| %>

      <div class="flex-1">
        <%= form.text_field :busca,
            value: params[:busca],
            placeholder: "Buscar atividade...",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
      </div>

      <div class="md:w-48">
        <%= form.select :status,
            options_for_select(
              [
                ["Todos os status", ""],
                ["Agendada", "agendada"],
                ["Em andamento", "ativa"],
                ["Encerrada", "encerrada"]
              ],
              params[:status]
            ),
            {},
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
      </div>

      <%= form.submit "Filtrar",
          class: "cursor-pointer px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-900 text-sm font-medium text-white transition" %>

      <% if params[:busca].present? || params[:status].present? %>
        <%= link_to "Limpar",
            atividades_path,
            class: "inline-flex items-center justify-center px-3 py-2 text-sm text-slate-500 hover:text-slate-800" %>
      <% end %>

    <% end %>

  </div>


  <!-- TABELA -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">

    <% if @atividades.any? %>

      <div class="overflow-x-auto">

        <table class="w-full text-sm">

          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>

              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Atividade
              </th>

              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Tipo
              </th>

              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Data
              </th>

              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Turma
              </th>

              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Status
              </th>

              <th class="px-5 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Ações
              </th>

            </tr>
          </thead>


          <tbody class="divide-y divide-slate-100">

            <% @atividades.each do |atividade| %>

              <tr class="hover:bg-slate-50 transition">

                <!-- ATIVIDADE -->
                <td class="px-5 py-4">

                  <%= link_to atividade_path(atividade),
                      class: "font-semibold text-slate-800 hover:text-blue-600 transition" do %>
                    <%= atividade.nome %>
                  <% end %>

                  <% if atividade.local.present? %>
                    <p class="text-xs text-slate-400 mt-1">
                      <%= atividade.local %>
                    </p>
                  <% end %>

                </td>


                <!-- TIPO -->
                <td class="px-4 py-4 text-slate-600">
                  <%= atividade.tipo_atividade %>
                </td>


                <!-- DATA -->
                <td class="px-4 py-4 text-slate-600 whitespace-nowrap">

                  <% if atividade.inicio.present? %>
                    <%= atividade.inicio.strftime("%d/%m/%Y") %>
                  <% else %>
                    <span class="text-slate-400">—</span>
                  <% end %>

                </td>


                <!-- TURMA -->
                <td class="px-4 py-4">

                  <% turma = atividade.turmas.first %>

                  <% if turma.present? %>
                    <span class="text-slate-700">
                      <%= turma.nome %>
                    </span>
                  <% else %>
                    <span class="text-xs text-slate-400">
                      Sem turma
                    </span>
                  <% end %>

                </td>


                <!-- STATUS -->
                <td class="px-4 py-4">

                  <% if atividade.status == "ativa" %>

                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Em andamento
                    </span>

                  <% elsif atividade.status == "encerrada" %>

                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                      Encerrada
                    </span>

                  <% else %>

                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      Agendada
                    </span>

                  <% end %>

                </td>


                <!-- AÇÕES -->
                <td class="px-5 py-4">

                  <div class="flex items-center justify-end gap-3">

                    <%= link_to "Ver",
                        atividade_path(atividade),
                        class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>

                    <%= link_to "Editar",
                        edit_atividade_path(atividade),
                        class: "text-xs font-medium text-slate-500 hover:text-slate-900" %>

                    <%= button_to "Excluir",
                        atividade_path(atividade),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Deseja realmente excluir esta atividade?"
                          }
                        },
                        class: "text-xs font-medium text-red-500 hover:text-red-700 bg-transparent border-0 p-0 cursor-pointer" %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>


      <!-- PAGINAÇÃO -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 py-4 border-t border-slate-200 bg-slate-50/50">

        <div class="text-xs text-slate-500">

          <% if @atividades.respond_to?(:current_page) %>

            Página
            <span class="font-semibold text-slate-700">
              <%= @atividades.current_page %>
            </span>

            de
            <span class="font-semibold text-slate-700">
              <%= @atividades.total_pages %>
            </span>

            <span class="mx-1">•</span>

            <%= @atividades.total_count %>
            <%= @atividades.total_count == 1 ? "atividade" : "atividades" %>

          <% end %>

        </div>


        <% if @atividades.respond_to?(:total_pages) && @atividades.total_pages > 1 %>

          <div class="text-sm">
            <%= paginate @atividades,
                params: {
                  busca: params[:busca],
                  status: params[:status]
                } %>
          </div>

        <% end %>

      </div>


    <% else %>

      <!-- NENHUMA ATIVIDADE -->
      <div class="px-6 py-14 text-center">

        <div class="w-10 h-10 mx-auto mb-3 rounded-full bg-slate-100 flex items-center justify-center">

          <svg xmlns="http://www.w3.org/2000/svg"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="1.8"
               class="w-5 h-5 text-slate-400">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6.75 3v2.25M17.25 3v2.25M3.75 9.75h16.5M5.25 5.25h13.5A1.5 1.5 0 0120.25 6.75v12A1.5 1.5 0 0118.75 20.25H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

          </svg>

        </div>

        <p class="text-sm font-semibold text-slate-700">
          Nenhuma atividade encontrada
        </p>

        <p class="text-xs text-slate-400 mt-1">
          Cadastre uma atividade ou altere os filtros utilizados.
        </p>

        <%= link_to "Criar atividade",
            new_atividade_path,
            class: "inline-block mt-4 text-xs font-semibold text-blue-600 hover:text-blue-800" %>

      </div>

    <% end %>

  </div>

</div>
