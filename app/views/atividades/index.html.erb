<section class="activities basic-page" aria-labelledby="activities-title">
  <header class="page-header">
    <div>
      <h1 id="activities-title">Atividades</h1>
      <p class="subtitle">Cadastre, consulte e gerencie suas atividades.</p>
    </div>
    <%= link_to new_atividade_path, class: "btn btn-primary" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round" /></svg>
      Nova atividade
    <% end %>
  </header>

  <div class="filters">
    <%= form_with url: atividades_path, method: :get, local: true, class: "filter-grid", role: "search" do |form| %>
      <div class="field">
        <%= form.label :busca, "Buscar atividade" %>
        <%= form.text_field :busca, value: params[:busca], placeholder: "Digite o nome da atividade…" %>
      </div>
      <div class="field">
        <%= form.label :status, "Status" %>
        <%= form.select :status, options_for_select([["Todos os status", ""], ["Agendada", "agendada"], ["Em andamento", "ativa"], ["Encerrada", "encerrada"]], params[:status]) %>
      </div>
      <div class="filter-actions">
        <%= form.submit "Filtrar", class: "btn btn-primary" %>
        <% if params[:busca].present? || params[:status].present? %>
          <%= link_to "Limpar", atividades_path, class: "btn" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>Atividades cadastradas</h2>
      <p>Consulte os detalhes ou gerencie uma atividade.</p>
    </div>
    <% if @atividades.any? %>
      <table aria-label="Atividades cadastradas">
        <thead><tr>
          <% ["Atividade", "Tipo", "Data", "Turmas", "Status", "Ações"].each do |coluna| %>
            <th scope="col"><%= coluna %></th>
          <% end %>
        </tr></thead>
        <tbody>
          <% @atividades.each do |atividade| %>
            <% turmas = atividade.turmas.to_a %>
            <%
              status_label, status_class =
                case atividade.status
                when "ativa" then ["Em andamento", "badge-active"]
                when "encerrada" then ["Encerrada", "badge-closed"]
                when "agendada" then ["Agendada", "badge-scheduled"]
                else [atividade.status.presence || "Não informado", "badge-closed"]
                end
            %>
            <tr>
              <td data-label="Atividade">
                <%= link_to atividade.nome, atividade_path(atividade), class: "activity-name" %>
                <% if atividade.local.present? %><p class="location"><%= atividade.local %></p><% end %>
              </td>
              <td data-label="Tipo"><%= atividade.tipo_atividade.presence || "Não informado" %></td>
              <td data-label="Data">
                <% if atividade.inicio.present? %>
                  <time datetime="<%= atividade.inicio.iso8601 %>"><%= atividade.inicio.strftime("%d/%m/%Y") %></time>
                <% else %><span class="secondary">Não definida</span><% end %>
              </td>
              <td data-label="Turmas">
                <% if turmas.any? %><%= turmas.map(&:nome).join(", ") %>
                <% else %><span class="secondary">Sem turma</span><% end %>
              </td>
              <td data-label="Status"><span class="badge <%= status_class %>"><%= status_label %></span></td>
              <td data-label="Ações">
                <div class="actions">
                  <%= link_to "Ver", atividade_path(atividade), class: "action action-view", aria: { label: "Ver #{atividade.nome}" } %>
                  <%= link_to "Editar", edit_atividade_path(atividade), class: "action", aria: { label: "Editar #{atividade.nome}" } %>
                  <%= button_to "Excluir", atividade_path(atividade), method: :delete, form: { data: { turbo_confirm: "Deseja realmente excluir esta atividade?" } }, class: "action action-delete", aria: { label: "Excluir #{atividade.nome}" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <footer class="footer">
        <p>
          <% if @atividades.respond_to?(:current_page) && @atividades.respond_to?(:total_pages) && @atividades.respond_to?(:total_count) %>
            Página <strong><%= @atividades.current_page %></strong> de <strong><%= @atividades.total_pages %></strong> ·
            <%= pluralize(@atividades.total_count, "atividade", "atividades") %>
          <% else %><%= pluralize(@atividades.size, "atividade", "atividades") %><% end %>
        </p>
        <% if @atividades.respond_to?(:total_pages) && @atividades.total_pages > 1 %>
          <nav class="pagination-wrap" aria-label="Paginação das atividades">
            <%= paginate @atividades, params: { busca: params[:busca], status: params[:status] } %>
          </nav>
        <% end %>
      </footer>
    <% else %>
      <div class="empty">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18M8 15h3" stroke-linecap="round"/></svg></div>
        <h2>Nenhuma atividade encontrada</h2>
        <% if params[:busca].present? || params[:status].present? %>
          <p>Experimente outro nome ou remova os filtros para ver as atividades cadastradas.</p>
          <%= link_to "Limpar filtros", atividades_path, class: "btn btn-primary" %>
        <% else %>
          <p>Cadastre sua primeira atividade para começar a organizar a rotina pedagógica.</p>
          <%= link_to "Criar atividade", new_atividade_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
