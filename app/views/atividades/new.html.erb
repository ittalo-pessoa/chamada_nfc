<div class="w-full max-w-4xl mx-auto">

  <div class="mb-6">

    <%= link_to "← Atividades",
        atividades_path,
        class: "text-xs text-slate-500 hover:text-blue-600" %>

    <h1 class="text-2xl font-bold text-slate-900 mt-3">
      Nova atividade
    </h1>

    <p class="text-sm text-slate-500 mt-1">
      Cadastre uma aula, monitoria ou outra atividade pedagógica.
    </p>

  </div>

  <%= render "form", atividade: @atividade %>

</div>
