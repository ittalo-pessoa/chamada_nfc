<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
  <head>
    <title>SmartChamada</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "application", "interface", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <div class="app-shell">
      <aside class="app-sidebar">
        <%= link_to "SmartChamada", root_path, class: "app-brand" %>
        <p class="app-tagline">Chamada NFC</p>
        <nav class="app-navigation" aria-label="Menu principal">
          <% [["Dashboard", root_path, "dashboard"], ["Turmas", turmas_path, "turmas"], ["Alunos", alunos_path, "alunos"], ["Atividades", atividades_path, "atividades"], ["Presenças", presencas_path, "presencas"], ["Dispositivos", dispositivos_path, "dispositivos"], ["Relatórios", relatorios_path, "relatorios"], ["Parâmetros", parametros_path, "parametros"]].each do |label, path, name| %>
            <%= link_to label, path, class: (controller_name == name ? "is-active" : nil), aria: { current: (controller_name == name ? "page" : nil) } %>
          <% end %>
        </nav>
      </aside>
      <main class="app-main" id="conteudo">
        <% if notice.present? %><p class="app-notice" role="status"><%= notice %></p><% end %>
        <% if alert.present? %><p class="app-alert" role="alert"><%= alert %></p><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
