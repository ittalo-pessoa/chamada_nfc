<%= form_with model: dispositivo, class: "space-y-5" do |form| %>

  <% if dispositivo.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <% dispositivo.errors.full_messages.each do |message| %>
        <p class="text-sm text-red-600">
          <%= message %>
        </p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :nome, "Nome do dispositivo",
        class: "block text-sm font-medium text-slate-700 mb-1" %>

    <%= form.text_field :nome,
        placeholder: "Ex.: Leitor NFC - Laboratório",
        class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= form.label :local, "Local (opcional)",
        class: "block text-sm font-medium text-slate-700 mb-1" %>

    <%= form.text_field :local,
        placeholder: "Ex.: Laboratório de Informática",
        class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <label class="flex items-center gap-2">
    <%= form.check_box :ativo %>

    <span class="text-sm text-slate-700">
      Dispositivo ativo
    </span>
  </label>

  <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">

    <%= link_to "Cancelar",
        dispositivos_path,
        class: "px-4 py-2 text-sm text-slate-600" %>

    <%= form.submit "Salvar dispositivo",
        class: "cursor-pointer px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-sm font-semibold text-white" %>

  </div>

<% end %>
